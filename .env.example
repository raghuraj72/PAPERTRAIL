# PAPERTRAIL — Configuration Environment Variables
PROJECT_NAME="PAPERTRAIL — The Clarity Engine"
TAGLINE="Understand the requirements. Know what to do. Never submit blindly."

# Backend Server
PORT=8000
HOST="127.0.0.1"

# AI Provider Selection: deterministic | gemini | ollama
# Note: "deterministic" is the default and runs 100% locally with zero API keys required!
AI_PROVIDER="deterministic"

# Optional: Google Gemini API (if using gemini provider)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional: Ollama Local Inference (if running Ollama with Gemma)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma:2b"

# Privacy & Limits
MAX_UPLOAD_SIZE_MB=25
DATA_RETENTION_HOURS=48
